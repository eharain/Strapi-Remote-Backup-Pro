# ---- build output ----
artifacts/
dist/
build/out/
*.tsbuildinfo

# ---- node ----
node_modules/
.pnpm-store/
npm-debug.log*
pnpm-debug.log*
.eslintcache
coverage/
.vitest/

# ---- dotnet ----
# Scoped to the desktop app deliberately. A bare `bin/` also matches
# apps/core/bin/, which holds the CLI entry point package.json declares under
# "bin" — ignoring it publishes an npm package whose command is not in the
# tarball, and `npx strapi-remote-backup-pro` fails on the first run.
apps/desktop/**/bin/
apps/desktop/**/obj/
[Dd]ebug/
[Rr]elease/
*.user
*.suo
.vs/
*.binlog

# ---- packaging ----
build/installers/**/out/
build/vendor/node/
apps/core/npm/*/bin/

# ---- local secrets & state ----
.env
.env.*
!.env.example
*.local.json
profiles/
*.sbk
*.sbk.zip

# ---- os ----
.DS_Store
Thumbs.db

# Git Bash on Windows drops these next to the working directory on a crash.
*.stackdump
