{
  "$ref": "#/definitions/RestoreOptions",
  "definitions": {
    "RestoreOptions": {
      "type": "object",
      "properties": {
        "selection": {
          "type": "object",
          "properties": {
            "contentTypes": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "documentIds": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            },
            "depth": {
              "default": 1,
              "type": "integer",
              "minimum": 0,
              "maximum": 10
            },
            "followUnselectedTypes": {
              "default": true,
              "type": "boolean"
            },
            "includeMedia": {
              "default": true,
              "type": "boolean"
            },
            "includeSchemas": {
              "default": true,
              "type": "boolean"
            },
            "includeDrafts": {
              "default": true,
              "type": "boolean"
            },
            "locales": {
              "default": [],
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "modifiedSince": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "strategy": {
          "default": "upsert",
          "type": "string",
          "enum": [
            "create",
            "upsert",
            "skip",
            "replace"
          ]
        },
        "dryRun": {
          "default": false,
          "type": "boolean"
        },
        "restoreMedia": {
          "default": true,
          "type": "boolean"
        },
        "preservePublishState": {
          "default": true,
          "type": "boolean"
        },
        "stopOnError": {
          "default": false,
          "type": "boolean"
        }
      },
      "required": [
        "selection"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
