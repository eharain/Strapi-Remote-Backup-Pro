{
  "$ref": "#/definitions/RestoreRequest",
  "definitions": {
    "RestoreRequest": {
      "type": "object",
      "properties": {
        "connection": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "format": "uri"
            },
            "credentials": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "admin"
                    },
                    "email": {
                      "type": "string",
                      "format": "email"
                    },
                    "password": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "email",
                    "password"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "kind": {
                      "type": "string",
                      "const": "apiToken"
                    },
                    "token": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "kind",
                    "token"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "insecureTls": {
              "default": false,
              "type": "boolean"
            },
            "requestTimeoutMs": {
              "default": 60000,
              "type": "integer",
              "exclusiveMinimum": 0,
              "maximum": 9007199254740991
            },
            "concurrency": {
              "default": 4,
              "type": "integer",
              "minimum": 1,
              "maximum": 32
            }
          },
          "required": [
            "url",
            "credentials"
          ],
          "additionalProperties": false
        },
        "source": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "enum": [
                "local",
                "s3",
                "azureBlob",
                "googleDrive",
                "dropbox",
                "oneDrive",
                "sftp",
                "ftp"
              ]
            },
            "name": {
              "type": "string"
            },
            "settings": {
              "default": {},
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {}
            },
            "secretRef": {
              "type": "string"
            },
            "retention": {
              "type": "object",
              "properties": {
                "keepLast": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                },
                "keepDays": {
                  "type": "integer",
                  "exclusiveMinimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "id",
            "kind",
            "name"
          ],
          "additionalProperties": false
        },
        "archivePath": {
          "type": "string"
        },
        "options": {
          "type": "object",
          "properties": {
            "selection": {
              "type": "object",
              "properties": {
                "contentTypes": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "documentIds": {
                  "default": {},
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "depth": {
                  "default": 1,
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 10
                },
                "followUnselectedTypes": {
                  "default": true,
                  "type": "boolean"
                },
                "includeMedia": {
                  "default": true,
                  "type": "boolean"
                },
                "includeSchemas": {
                  "default": true,
                  "type": "boolean"
                },
                "includeDrafts": {
                  "default": true,
                  "type": "boolean"
                },
                "locales": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                },
                "modifiedSince": {
                  "type": "string",
                  "format": "date-time"
                }
              },
              "additionalProperties": false
            },
            "strategy": {
              "default": "upsert",
              "type": "string",
              "enum": [
                "create",
                "upsert",
                "skip",
                "replace"
              ]
            },
            "dryRun": {
              "default": false,
              "type": "boolean"
            },
            "restoreMedia": {
              "default": true,
              "type": "boolean"
            },
            "preservePublishState": {
              "default": true,
              "type": "boolean"
            },
            "stopOnError": {
              "default": false,
              "type": "boolean"
            }
          },
          "required": [
            "selection"
          ],
          "additionalProperties": false
        },
        "decryptionPassphrase": {
          "type": "string"
        }
      },
      "required": [
        "connection",
        "source",
        "archivePath",
        "options"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
