{
  "$ref": "#/definitions/Manifest",
  "definitions": {
    "Manifest": {
      "type": "object",
      "properties": {
        "formatVersion": {
          "type": "string"
        },
        "producedBy": {
          "type": "object",
          "properties": {
            "tool": {
              "type": "string",
              "const": "strapi-remote-backup-pro"
            },
            "version": {
              "type": "string"
            }
          },
          "required": [
            "tool",
            "version"
          ],
          "additionalProperties": false
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "label": {
          "type": "string"
        },
        "source": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            },
            "version": {
              "type": "string",
              "enum": [
                "v4",
                "v5"
              ]
            },
            "versionString": {
              "type": "string"
            }
          },
          "required": [
            "url",
            "version"
          ],
          "additionalProperties": false
        },
        "selection": {
          "type": "object",
          "properties": {
            "contentTypes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "documentIds": {
              "type": "object",
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "default": {}
            },
            "depth": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10,
              "default": 1
            },
            "followUnselectedTypes": {
              "type": "boolean",
              "default": true
            },
            "includeMedia": {
              "type": "boolean",
              "default": true
            },
            "includeSchemas": {
              "type": "boolean",
              "default": true
            },
            "includeDrafts": {
              "type": "boolean",
              "default": true
            },
            "locales": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "default": []
            },
            "modifiedSince": {
              "type": "string",
              "format": "date-time"
            }
          },
          "additionalProperties": false
        },
        "encryption": {
          "type": "object",
          "properties": {
            "algorithm": {
              "type": "string",
              "const": "aes-256-gcm"
            },
            "kdf": {
              "type": "string",
              "const": "scrypt"
            },
            "salt": {
              "type": "string"
            }
          },
          "required": [
            "algorithm",
            "kdf",
            "salt"
          ],
          "additionalProperties": false
        },
        "contents": {
          "type": "object",
          "properties": {
            "contentTypes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "uid": {
                    "type": "string"
                  },
                  "recordCount": {
                    "type": "number"
                  },
                  "file": {
                    "type": "string"
                  },
                  "sha256": {
                    "type": "string"
                  }
                },
                "required": [
                  "uid",
                  "recordCount",
                  "file",
                  "sha256"
                ],
                "additionalProperties": false
              }
            },
            "mediaFiles": {
              "type": "number"
            },
            "mediaBytes": {
              "type": "number"
            },
            "componentCount": {
              "type": "number"
            },
            "locales": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "contentTypes",
            "mediaFiles",
            "mediaBytes",
            "componentCount",
            "locales"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "formatVersion",
        "producedBy",
        "createdAt",
        "source",
        "selection",
        "contents"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
