{
  "$ref": "#/definitions/Connection",
  "definitions": {
    "Connection": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string",
          "format": "uri"
        },
        "credentials": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "admin"
                },
                "email": {
                  "type": "string",
                  "format": "email"
                },
                "password": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "email",
                "password"
              ],
              "additionalProperties": false
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "apiToken"
                },
                "token": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "kind",
                "token"
              ],
              "additionalProperties": false
            }
          ]
        },
        "insecureTls": {
          "default": false,
          "type": "boolean"
        },
        "requestTimeoutMs": {
          "default": 60000,
          "type": "integer",
          "exclusiveMinimum": 0,
          "maximum": 9007199254740991
        },
        "concurrency": {
          "default": 4,
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "url",
        "credentials"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
