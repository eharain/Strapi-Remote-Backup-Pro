{
  "$ref": "#/definitions/RunReport",
  "definitions": {
    "RunReport": {
      "type": "object",
      "properties": {
        "jobId": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "backup",
            "restore",
            "verify"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "startedAt": {
          "type": "string",
          "format": "date-time"
        },
        "finishedAt": {
          "type": "string",
          "format": "date-time"
        },
        "durationMs": {
          "type": "number"
        },
        "recordsByType": {
          "default": {},
          "type": "object",
          "propertyNames": {
            "type": "string"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "mediaFiles": {
          "default": 0,
          "type": "number"
        },
        "bytesWritten": {
          "default": 0,
          "type": "number"
        },
        "warnings": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "default": [],
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "jobId",
        "kind",
        "state",
        "startedAt",
        "finishedAt",
        "durationMs"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
