{
  "$ref": "#/definitions/Credentials",
  "definitions": {
    "Credentials": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "admin"
            },
            "email": {
              "type": "string",
              "format": "email"
            },
            "password": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "email",
            "password"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "apiToken"
            },
            "token": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "kind",
            "token"
          ],
          "additionalProperties": false
        }
      ]
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
