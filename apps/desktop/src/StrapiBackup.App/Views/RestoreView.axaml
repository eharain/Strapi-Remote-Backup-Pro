<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="StrapiBackup.App.Views.RestoreView">
  <!-- Restore plan as a reviewable diff: creates, updates, deletes, skips, plus
       schema drift and dangling-relation warnings.

       Restore writes to a live CMS, so the plan is always shown and always
       requires confirmation. Destructive strategies are visually distinct from
       additive ones — 'replace' deletes before writing and is the only path that
       can lose data the archive does not contain. -->
  <Grid />
</UserControl>
